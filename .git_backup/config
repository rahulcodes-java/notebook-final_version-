[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/rahulcodes-java/notebook-final_version-.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "all-local-demo"]
	remote = origin
	merge = refs/heads/all-local-demo
	vscode-merge-base = origin/all-local-demo
